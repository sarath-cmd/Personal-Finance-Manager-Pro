# MongoDB Atlas connection string (dedicated DB user, scoped to this app's database only)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/personal_finance?retryWrites=true&w=majority

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Local dev: http://localhost:3000  |  Production: your Vercel deployment URL
NEXTAUTH_URL=http://localhost:3000

# Optional — rate limiting for register/login (Upstash free tier). Leave blank to fall back
# to the in-database rate limiter (see lib/rateLimit.ts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
